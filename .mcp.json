{
  "mcpServers": {
    "kyte": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/server/kyte.cjs"],
      "env": {
        "CLAUDE_PLUGIN_OPTION_READ_ONLY": "${user_config.read_only}",
        "CLAUDE_PLUGIN_OPTION_DATA_FOLDER": "${user_config.data_folder}",
        "CLAUDE_PLUGIN_OPTION_KYTE_PATH": "${user_config.kyte_path}"
      }
    }
  }
}
